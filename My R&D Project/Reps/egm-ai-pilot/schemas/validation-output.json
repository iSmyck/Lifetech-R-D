{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validation Agent Output",
  "description": "Output schema for the Validation & Guardrails Agent",
  "type": "object",
  "required": ["query_id", "validation_status", "consistency_report", "aggregated_risk_flags", "flag_for_hitl", "timestamp"],
  "properties": {
    "query_id": { "type": "string", "format": "uuid" },
    "validation_status": { "type": "string", "enum": ["valid_and_safe", "needs_review", "critical_error"] },
    "consistency_report": {
      "type": "object",
      "required": ["checks_performed"],
      "properties": {
        "checks_performed": { "type": "array", "items": { "type": "string" } },
        "inconsistencies_found": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "between_agents": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" },
              "severity": { "type": "string" }
            }
          }
        }
      }
    },
    "aggregated_risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_agent": { "type": "string" },
          "flag_type": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        }
      }
    },
    "auto_repairs_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string" },
          "original": {},
          "repaired": {},
          "reason": { "type": "string" }
        }
      }
    },
    "flag_for_hitl": { "type": "boolean" },
    "hitl_reason": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
