{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Localization Agent Output",
  "description": "Output schema for the Localization Agent",
  "type": "object",
  "required": ["query_id", "localized_content", "localization_report", "confidence_score", "timestamp"],
  "properties": {
    "query_id": { "type": "string", "format": "uuid" },
    "localized_content": {
      "type": "object",
      "required": ["text", "call_to_action"],
      "properties": {
        "text": { "type": "string" },
        "image_suggestions": { "type": "string" },
        "call_to_action": { "type": "string" },
        "bilingual_version": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" }
          }
        }
      }
    },
    "localization_report": {
      "type": "object",
      "required": ["cultural_codes_applied", "generational_lens", "market_insights_applied"],
      "properties": {
        "cultural_codes_applied": { "type": "array", "items": { "type": "string" } },
        "generational_lens": { "type": "string" },
        "market_insights_applied": { "type": "string" },
        "cultural_sensitivities_addressed": { "type": "array", "items": { "type": "string" } },
        "local_benchmarking_references": { "type": "array", "items": { "type": "string" } },
        "potential_risks_flagged": { "type": "array", "items": { "type": "string" } }
      }
    },
    "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
