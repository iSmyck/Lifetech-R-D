    {
      "parameters": {
        "jsCode": "// Extract Jira Key (e.g., PROJ-123) from the AI query\nconst query = $input.first().json.query || '';\nconst match = query.match(/[A-Z][A-Z0-9]+-\\d+/);\n\nif (!match) {\n  return [{ json: { error: 'No valid Jira ticket key found in the query.', ticketKey: null } }];\n}\n\nreturn [{ json: { ticketKey: match[0], sessionId: $input.first().json.sessionId } }];"
      },
      "id": "4a2df3c6-4055-40dd-b31c-0f1dbc90b6df",
      "name": "Extract Ticket Key",
      "type": "n8n-nodes-base.code",
