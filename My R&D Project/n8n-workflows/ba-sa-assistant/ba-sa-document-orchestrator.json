    {
      "parameters": {
        "jsCode": "// Format the final response for chat\nconst result = $input.first().json;\n\nconst preview = result.content ? result.content.substring(0, 2000) + '...' : 'Document generated.';\n\nconst response = `## ✅ Document Draft Created\\\\n\\\\n**Title:** ${result.title || 'Untitled'}\\\\n**Type:** ${result.templateName || 'Document'}\\\\n**Draft ID:** ${result.documentId || 'N/A'}\\\\n**Diagrams:** ${(result.diagrams || []).length} generated\\\\n\\\\n---\\\\n\\\\n### Preview\\\\n\\\\n${preview}\\\\n\\\\n---\\\\n\\\\n⏳ **Awaiting your review...**\\\\n\\\\nReply with:\\n- **\\\"Approve\\\"** to publish to Wiki.js\\n- **\\\"Edit: [your changes]\\\"** to request modifications\\n- **\\\"Reject\\\"** to discard this draft`;\n\nreturn [{\n  json: {\n    response: response,\n    documentId: result.documentId,\n    title: result.title,\n    content: result.content,\n    markdown: result.markdown,\n    diagrams: result.diagrams,\n    status: 'pending_review',\n    intent: 'CREATE_DOCUMENT',\n    sessionId: result.sessionId\n  }\n}];"
      },
      "id": "format-chat-response",
      "name": "Format Chat Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        300
      ]
    }
