# =============================================================================
# BA/SA AI Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# These variables are referenced by the n8n workflow nodes.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Configuration — On-Premise OpenAI-Compatible API
# -----------------------------------------------------------------------------

# Your on-premise LLM base URL (OpenAI-compatible)
# Examples:
#   vLLM:        http://localhost:8000/v1
#   TGI:         http://localhost:8080/v1
#   Ollama:      http://localhost:11434/v1
#   LiteLLM:     http://localhost:4000/v1
#   OpenAI:      https://api.openai.com/v1
#   Kimi:        https://api.moonshot.cn/v1
LLM_BASE_URL=http://localhost:8000/v1

# Model name supported by your endpoint
# Examples: gpt-4o, llama3-70b, qwen-72b, kimi-latest
LLM_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector (same as existing project)
# -----------------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=egm_ai_pilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# -----------------------------------------------------------------------------
# Jira Configuration
# -----------------------------------------------------------------------------

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=YOURPROJECT

# -----------------------------------------------------------------------------
# Wiki.js Configuration (Knowledge Base)
# -----------------------------------------------------------------------------

WIKI_JS_URL=https://wiki.yourcompany.com
WIKI_JS_API_KEY=your-wiki-js-api-key

# Default wiki path for published documents
WIKI_JS_DEFAULT_PATH=ba-sa-docs

# -----------------------------------------------------------------------------
# Kroki Configuration (Diagram Validation)
# -----------------------------------------------------------------------------

# Kroki server URL for validating Mermaid/PlantUML diagrams
# Use public instance: https://kroki.io
# Or self-hosted:      http://localhost:8000
KROKI_URL=https://kroki.io

# -----------------------------------------------------------------------------
# n8n Configuration
# -----------------------------------------------------------------------------

N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=n8n_api_your_key_here

# Sub-workflow IDs (set AFTER importing workflows into n8n)
# After importing each workflow, copy its ID from the n8n UI
WORKFLOW_ID_ORCHESTRATOR_CHAT=100
WORKFLOW_ID_RAG_AGENT=101
WORKFLOW_ID_INPUT_ANALYZER=102
WORKFLOW_ID_RAG_RESEARCHER=103
WORKFLOW_ID_TEMPLATE_SELECTOR=104
WORKFLOW_ID_DOCUMENT_COMPOSER=105
WORKFLOW_ID_DIAGRAM_GENERATOR=106
WORKFLOW_ID_DOCUMENT_ASSEMBLER=107
WORKFLOW_ID_HITL_REVIEW=108
WORKFLOW_ID_DOC_ORCHESTRATOR=109

# =============================================================================
# Credential Setup (configure these in n8n UI, not in .env)
# =============================================================================
#
# 1. OpenAI On-Premise (n8n Settings > Credentials)
#    - Name: OpenAI On-Premise
#    - Type: OpenAI API
#    - API Key: your-on-premise-api-key
#    - Note: baseURL is overridden in each node via env var
#
# 2. Postgres Default (n8n Settings > Credentials)
#    - Name: Postgres Default
#    - Host, Port, Database, User, Password
#
# 3. Jira Software (n8n Settings > Credentials)
#    - Name: Jira Default
#    - Jira URL, Email, API Token
#
# 4. Wiki.js (n8n Settings > Credentials)
#    - Use HTTP Header Auth or Generic Credential Type
#    - Name: Wiki.js API Key
#
# =============================================================================
