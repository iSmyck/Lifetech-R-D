{
  "name": "AstroBot 07 - Error Handler",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "id": "error-trigger-07",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "// Parse error trigger data\nconst error = $input.first().json;\n\nconst workflowName = error.workflow?.name || 'unknown';\nconst errorMessage = error.execution?.error?.message || 'Unknown error';\nconst nodeName = error.execution?.error?.node?.name || 'unknown';\nconst telegramId = error.execution?.data?.resultData?.runData?.[nodeName]?.[0]?.data?.main?.[0]?.[0]?.json?.telegram_id || null;\n\nreturn [{\n  json: {\n    workflow_name: workflowName,\n    error_message: errorMessage,\n    node_name: nodeName,\n    telegram_id: telegramId,\n    payload: error\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300],
      "id": "parse-error-07",
      "name": "Parse Error"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO error_log (telegram_id, workflow_name, error_message, payload, created_at) VALUES ($1, $2, $3, $4, NOW());",
        "options": {
          "queryParams": {
            "parameters": [
              { "name": "telegram_id", "value": "={{ $json.telegram_id }}" },
              { "name": "workflow_name", "value": "={{ $json.workflow_name }}" },
              { "name": "error_message", "value": "={{ $json.error_message }}" },
              { "name": "payload", "value": "={{ JSON.stringify($json.payload) }}" }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [640, 300],
      "id": "postgres-log-error-07",
      "name": "Log Error to DB",
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CONNECTION",
          "name": "PostgreSQL Connection"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-telegram",
              "leftValue": "={{ $json.telegram_id }}",
              "rightValue": "",
              "operator": {
                "name": "string.notEquals",
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 300],
      "id": "if-has-telegram-07",
      "name": "Has Telegram ID?"
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_id }}",
        "text": "⚠️ Произошла техническая ошибка. Попробуйте позже или используйте /start для перезапуска.",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1080, 260],
      "id": "telegram-error-msg-07",
      "name": "Send Error Message",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_BOT_TOKEN",
          "name": "Telegram Bot Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Retry logic notification for critical workflows\nconst item = $input.first().json;\n\n// Could integrate with external alerting (e.g., Slack, Email)\nreturn [{\n  json: {\n    ...item,\n    alert_sent: true,\n    alert_time: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 380],
      "id": "alert-admin-07",
      "name": "Alert Admin"
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Parse Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Error": {
      "main": [
        [
          {
            "node": "Log Error to DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error to DB": {
      "main": [
        [
          {
            "node": "Has Telegram ID?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Telegram ID?": {
      "main": [
        [
          {
            "node": "Send Error Message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["astrobot", "error-handler"]
}
