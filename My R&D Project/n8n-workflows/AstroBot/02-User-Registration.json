        "jsCode": "// Validate name\nconst item = $input.first().json;\nconst name = (item.text || '').trim();\n\nconst isValid = name.length >= 2 && name.length <= 50 && /^[\\p{L}\\s\\-'.]+$/u.test(name);\n\nreturn [{\n  json: {\n    ...item,\n    name_valid: isValid,\n    name_value: name\n  }\n}];"
