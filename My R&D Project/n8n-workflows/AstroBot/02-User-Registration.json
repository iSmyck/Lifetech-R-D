    {
      "parameters": {
        "jsCode": "// Parse geocoding response\nconst item = $input.first().json;\nconst geoData = item.body || [];\n\nlet geocoded = false;\nlet lat = null;\nlet lon = null;\nlet displayName = '';\nlet nation = '';\nlet timezone = 'UTC';\n\nif (geoData.length > 0) {\n  const place = geoData[0];\n  lat = parseFloat(place.lat);\n  lon = parseFloat(place.lon);\n  displayName = place.display_name;\n  \n  // Extract country code from display name (fallback logic)\n  const parts = displayName.split(', ');\n  const lastPart = parts[parts.length - 1];\n  // Simple mapping for common countries\n  const countryMap = {\n    'Russia': 'RU', 'Russian Federation': 'RU',\n    'United States': 'US', 'USA': 'US',\n    'United Kingdom': 'GB', 'Great Britain': 'GB',\n    'Germany': 'DE', 'France': 'FR', 'Italy': 'IT',\n    'Spain': 'ES', 'Ukraine': 'UA', 'Belarus': 'BY',\n    'Kazakhstan': 'KZ', 'Poland': 'PL', 'Turkey': 'TR'\n  };\n  nation = countryMap[lastPart] || 'RU';\n  \n  // Simple timezone estimation by longitude\n  const offset = Math.round(lon / 15);\n  const sign = offset >= 0 ? '+' : '-';\n  const absOffset = Math.abs(offset);\n  timezone = `Etc/GMT${sign}${absOffset}`;\n  \n  // Override for Russia\n  if (nation === 'RU') {\n    timezone = 'Europe/Moscow';\n  }\n  \n  geocoded = true;\n}\n\nreturn [{\n  json: {\n    ...item,\n    geocoded,\n    lat,\n    lon,\n    display_name: displayName,\n    nation,\n    timezone,\n    city: item.text\n  }\n}];"
      },
