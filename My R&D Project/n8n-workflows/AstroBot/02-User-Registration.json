        "jsCode": "// Build chart request body for SVG\nconst item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    chart_body: {\n      subject: {\n        name: item.state_data.full_name,\n        year: parseInt(item.state_data.birth_date.split('-')[0]),\n        month: parseInt(item.state_data.birth_date.split('-')[1]),\n        day: parseInt(item.state_data.birth_date.split('-')[2]),\n        hour: parseInt(item.state_data.birth_time.split(':')[0]),\n        minute: parseInt(item.state_data.birth_time.split(':')[1]),\n        second: 0,\n        longitude: item.lon,\n        latitude: item.lat,\n        timezone: item.timezone,\n        city: item.city,\n        nation: item.nation,\n        houses_system_identifier: 'P',\n        zodiac_type: 'Tropical'\n      },\n      theme: 'dark',\n      language: 'RU',\n      style: 'modern'\n    }\n  }\n}];"
