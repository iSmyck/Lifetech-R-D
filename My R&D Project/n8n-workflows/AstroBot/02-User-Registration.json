    {
      "parameters": {
        "jsCode": "// Determine registration step based on current state\nconst item = $input.first().json;\nconst state = item.user_state || 'INIT';\nconst text = item.text || '';\n\nlet nextAction = 'unknown';\n\nif (state === 'INIT' || text === '/start') {\n  nextAction = 'start_registration';\n} else if (state === 'ASK_NAME') {\n  nextAction = 'process_name';\n} else if (state === 'ASK_BIRTH_DATE') {\n  nextAction = 'process_birth_date';\n} else if (state === 'ASK_BIRTH_TIME') {\n  nextAction = 'process_birth_time';\n} else if (state === 'ASK_BIRTH_PLACE') {\n  nextAction = 'process_birth_place';\n} else if (state === 'CALCULATING_CHART') {\n  nextAction = 'calculate_chart';\n}\n\nreturn [{\n  json: {\n    ...item,\n    next_action: nextAction\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300],
      "id": "determine-step-02",
      "name": "Determine Step"
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "value": "={{ $json.next_action }}",
              "conditions": [
                {
                  "value": "start_registration",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ],
              "combinator": "and"
            },
            {
              "value": "={{ $json.next_action }}",
              "conditions": [
                {
                  "value": "process_name",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ],
              "combinator": "and"
            },
            {
              "value": "={{ $json.next_action }}",
              "conditions": [
                {
                  "value": "process_birth_date",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ],
              "combinator": "and"
            },
            {
              "value": "={{ $json.next_action }}",
              "conditions": [
                {
                  "value": "process_birth_time",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ],
              "combinator": "and"
            },
