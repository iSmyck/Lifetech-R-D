{
  "name": "AstroBot 04 - Free Question",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "id": "trigger-question-04",
      "name": "Execute Workflow Trigger"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-callback",
              "leftValue": "={{ $json.callback_data }}",
              "rightValue": "ask_question",
              "operator": {
                "name": "string.equals",
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [420, 300],
      "id": "if-ask-callback-04",
      "name": "Ask Question Callback?"
    },
    {
      "parameters": {
        "operation": "set",
        "key": "={{ 'astrobot:user:' + $json.telegram_id + ':state' }}",
        "expire": true,
        "ttl": 3600,
        "value": "={{ JSON.stringify({ current_state: 'AWAITING_QUESTION', data: $json.state_data || {}, last_interaction: new Date().toISOString() }) }}"
      },
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [640, 220],
      "id": "redis-awaiting-04",
      "name": "Redis Set AWAITING",
      "credentials": {
        "redis": {
          "id": "REDIS_CONNECTION",
          "name": "Redis Connection"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_id }}",
        "text": "Задайте ваш вопрос астрологу. Я проанализирую вашу карту и дам персональный ответ.\n\nНапример:\n• Какая карьера мне подходит?\n• Что ждёт в личной жизни?\n• Какие у меня таланты?",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [860, 220],
      "id": "telegram-ask-question-04",
      "name": "Prompt for Question",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_BOT_TOKEN",
          "name": "Telegram Bot Token"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT chart_context_xml FROM users WHERE telegram_id = $1 LIMIT 1;",
        "options": {
          "queryParams": {
            "parameters": [
              { "name": "telegram_id", "value": "={{ $json.telegram_id }}" }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [640, 380],
      "id": "postgres-get-context-04",
      "name": "Get Chart Context",
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CONNECTION",
          "name": "PostgreSQL Connection"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst chartContext = item.body?.[0]?.chart_context_xml || '';\nconst userQuestion = item.text || '';\n\nif (!chartContext) {\n  return [{ json: { ...item, chart_exists: false } }];\n}\n\nconst prompt = `## Натальная карта пользователя:\n${chartContext}\n\n## Вопрос пользователя:\n${userQuestion}\n\nОтветь на вопрос пользователя, опираясь на его натальную карту. Используй инструмент поиска по астрологической базе знаний для получения релевантных интерпретаций. Ссылайся на конкретные планеты, знаки и дома.`;\n\nreturn [{\n  json: {\n    ...item,\n    chart_exists: true,\n    prompt_text: prompt,\n    user_question: userQuestion\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 380],
      "id": "prepare-question-04",
      "name": "Prepare Question"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt_text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Ты — профессиональный астролог-консультант. Ты отвечаешь на вопросы пользователей, опираясь исключительно на их натальную карту и астрологические интерпретации из базы знаний.\n\nПравила:\n1. Используй инструмент поиска по астрологической базе для получения релевантных интерпретаций перед ответом.\n2. Отвечай ТОЛЬКО на основе предоставленных данных карты. Не фантазируй.\n3. Ссылайся на конкретные планеты, знаки и дома при формулировке ответа.\n4. Будь конкретным и практичным. Давай actionable советы.\n5. Максимум 3500 символов. Русский язык.\n6. Если вопрос выходит за рамки астрологии (медицина, юриспруденция), мягко переадресуй.",
          "maxIterations": 3
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [1080, 380],
      "id": "ai-agent-question-04",
      "name": "AI Agent Question"
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [960, 160],
      "id": "openai-question-04",
      "name": "OpenAI GPT-4o",
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_API_KEY",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ 'astrobot:question:' + $json.telegram_id }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.4,
      "position": [1080, 160],
      "id": "memory-question-04",
      "name": "Postgres Chat Memory",
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CONNECTION",
          "name": "PostgreSQL Connection"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "options": {
          "tableName": "rag_embeddings",
          "metadataFilter": ""
        }
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [1200, 160],
      "id": "pgvector-question-04",
      "name": "PGVector RAG",
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CONNECTION",
          "name": "PostgreSQL Connection"
        }
      }
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [1320, 280],
      "id": "embeddings-question-04",
      "name": "Embeddings OpenAI",
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_API_KEY",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "jsonSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"response\": {\n      \"type\": \"string\",\n      \"description\": \"Ответ астролога на вопрос пользователя на русском языке\"\n    }\n  },\n  \"required\": [\"response\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [1440, 160],
      "id": "output-parser-question-04",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst parsed = item.output || item;\nlet text = '';\nif (typeof parsed === 'object' && parsed !== null) {\n  text = parsed.response || parsed.text || JSON.stringify(parsed);\n} else {\n  text = String(parsed);\n}\nreturn [{\n  json: {\n    ...item,\n    response_text: text\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 380],
      "id": "format-response-04",
      "name": "Format Response"
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_id }}",
        "text": "={{ $json.response_text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1520, 380],
      "id": "telegram-answer-04",
      "name": "Send Answer",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_BOT_TOKEN",
          "name": "Telegram Bot Token"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_id }}",
        "text": "Есть ещё вопросы?",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "keyboard": [
            [
              {
                "text": "🔮 Новый вопрос",
                "callback_data": "ask_question"
              },
              {
                "text": "🔙 Главное меню",
                "callback_data": "main_menu"
              }
            ]
          ]
        },
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1740, 380],
      "id": "telegram-followup-04",
      "name": "Send Followup",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_BOT_TOKEN",
          "name": "Telegram Bot Token"
        }
      }
    },
    {
      "parameters": {
        "operation": "delete",
        "key": "={{ 'astrobot:user:' + $json.telegram_id + ':state' }}"
      },
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1740, 500],
      "id": "redis-reset-menu-04",
      "name": "Redis Reset to Menu",
      "credentials": {
        "redis": {
          "id": "REDIS_CONNECTION",
          "name": "Redis Connection"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_id }}",
        "text": "Сначала нужно пройти регистрацию. Используйте /start",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1080, 520],
      "id": "telegram-no-chart-04",
      "name": "No Chart Message",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_BOT_TOKEN",
          "name": "Telegram Bot Token"
        }
      }
    }
  ],
