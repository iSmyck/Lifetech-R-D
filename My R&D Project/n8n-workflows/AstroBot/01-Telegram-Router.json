      "position": [1380, 100],
      "id": "exec-registration-01",
      "name": "User Registration"
    },
    {
      "parameters": {
        "jsCode": "// Route based on state or callback for state-based flow\nconst item = $input.first().json;\nconst state = item.user_state;\nconst cb = item.callback_data;\nconst cmd = item.command;\n\nlet target = 'unknown';\n\nif (['ASK_NAME', 'ASK_BIRTH_DATE', 'ASK_BIRTH_TIME', 'ASK_BIRTH_PLACE', 'CALCULATING_CHART'].includes(state)) {\n  target = 'continue_registration';\n} else if (state === 'AWAITING_QUESTION' || cb === 'ask_question') {\n  target = 'free_question';\n} else if (state === 'MENU_MAIN' || cb === 'main_menu') {\n  if (cb === 'natal_chart' || cmd === '/chart') {\n    target = 'natal_chart';\n  } else if (cb === 'daily_forecast' || cmd === '/forecast') {\n    target = 'daily_forecast';\n  } else if (cb === 'compatibility') {\n    target = 'compatibility';\n  } else if (cb === 'settings' || cmd === '/settings') {\n    target = 'settings';\n  } else if (cmd === '/question') {\n    target = 'free_question';\n  } else if (cmd === '/help') {\n    target = 'help';\n  } else if (item.text || cb === 'main_menu') {\n    target = 'main_menu';\n  }\n} else {\n  target = 'main_menu';\n}\n\nreturn [{\n  json: {\n    ...item,\n    target: target\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1380, 300],
