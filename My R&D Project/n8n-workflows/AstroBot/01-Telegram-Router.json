          "callback_query"
        ],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "id": "telegram-trigger-01",
      "name": "Telegram Trigger",
      "webhookId": "astrobot-webhook",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_BOT_TOKEN",
          "name": "Telegram Bot Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract core fields from Telegram update\nconst update = $input.first().json;\n\nlet telegramId = null;\nlet messageType = 'unknown';\nlet text = '';\nlet callbackData = '';\nlet messageId = null;\nlet username = '';\nlet fullName = '';\n\nif (update.message) {\n  messageType = 'message';\n  telegramId = update.message.from.id;\n  text = update.message.text || '';\n  messageId = update.message.message_id;\n  username = update.message.from.username || '';\n  fullName = [update.message.from.first_name || '', update.message.from.last_name || ''].join(' ').trim();\n} else if (update.callback_query) {\n  messageType = 'callback_query';\n  telegramId = update.callback_query.from.id;\n  callbackData = update.callback_query.data || '';\n  messageId = update.callback_query.message?.message_id;\n  username = update.callback_query.from.username || '';\n  fullName = [update.callback_query.from.first_name || '', update.callback_query.from.last_name || ''].join(' ').trim();\n}\n\nreturn [{\n  json: {\n    telegram_id: telegramId,\n    message_type: messageType,\n    text: text,\n    callback_data: callbackData,\n    message_id: messageId,\n    username,\n    full_name: fullName,\n    raw_update: update\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "extract-fields-01",
      "name": "Extract Fields"
    },
    {
      "parameters": {
        "operation": "get",
        "key": "={{ 'astrobot:user:' + $json.telegram_id + ':state' }}"
      },
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [680, 300],
      "id": "redis-get-state-01",
      "name": "Redis Get State",
      "credentials": {
        "redis": {
          "id": "REDIS_CONNECTION",
          "name": "Redis Connection"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Redis state or default to INIT\nconst redisValue = $input.first().json.value;\nlet state = { current_state: 'INIT', data: {} };\n\nif (redisValue) {\n  try {\n    state = JSON.parse(redisValue);\n  } catch (e) {\n    state = { current_state: 'INIT', data: {} };\n  }\n}\n\nconst item = $input.first().json;\n\n// Handle commands override\nconst command = item.text?.startsWith('/') ? item.text.split(' ')[0] : '';\nlet route = 'state_based';\n\nif (command === '/start') {\n  route = 'registration';\n} else if (command === '/reset') {\n  route = 'reset';\n} else if (['/menu', '/chart', '/question', '/forecast', '/settings', '/help'].includes(command)) {\n  route = 'command';\n} else if (item.callback_data) {\n  route = 'callback';\n}\n\nreturn [{\n  json: {\n    ...item,\n    user_state: state.current_state,\n    state_data: state.data,\n    command: command,\n    route: route\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "id": "parse-state-01",
      "name": "Parse State & Route"
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "value": "={{ $json.route }}",
              "conditions": [
                {
                  "value": "registration",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                },
                {
                  "value": "={{ $json.user_state }}",
                  "operator": {
                    "type": "string",
                    "operation": "equals",
                    "rightValue": "INIT"
                  }
                },
                {
                  "value": "={{ $json.user_state }}",
                  "operator": {
                    "type": "string",
                    "operation": "equals",
                    "rightValue": "ASK_NAME"
                  }
                }
              ],
              "combinator": "or"
            },
            {
              "value": "={{ $json.route }}",
              "conditions": [
                {
                  "value": "state_based",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                },
                {
                  "value": "callback",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ],
              "combinator": "or"
            },
            {
              "value": "={{ $json.route }}",
              "conditions": [
                {
                  "value": "command",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ],
              "combinator": "and"
            },
            {
              "value": "={{ $json.route }}",
              "conditions": [
                {
                  "value": "reset",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ],
              "combinator": "and"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [1140, 300],
