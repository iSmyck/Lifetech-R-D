    "Send Natal Analysis": {
      "main": [
        [
          {
            "node": "Send Next Actions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI GPT-4o": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent Natal",
